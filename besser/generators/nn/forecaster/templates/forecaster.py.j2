# --------------------------------------------------------------------------- transforms
def can_log(series_list, log: bool = LOG) -> bool:
    """Whether the logarithm is used: ``log`` and every value of every series positive (one
    decision for all the series, so a pooled model has one scale)."""
    return bool(log) and all(len(s) > 0 and bool((np.asarray(s, dtype=float) > 0).all()) for s in series_list)


def to_model_scale(values, logged: bool) -> np.ndarray:
    """The values on the network's scale: their logarithm when ``logged``."""
    values = np.asarray(values, dtype=float)
    if not logged:
        return values.copy()
    if not (values > 0).all():
        raise ValueError(f"{MODEL_NAME} was trained on the logarithm of the series: every value must be positive")
    return np.log(values)


def difference(z: np.ndarray) -> np.ndarray:
    """d[t] = z[t] - z[t - DIFFERENCE], NaN where it is not defined (z itself when DIFFERENCE is 0)."""
    if DIFFERENCE == 0:
        return np.asarray(z, dtype=float).copy()
    d = np.full(len(z), np.nan)
    d[DIFFERENCE:] = z[DIFFERENCE:] - z[:-DIFFERENCE]
    return d


def undifference(z: np.ndarray, d_next: np.ndarray) -> np.ndarray:
    """The values that follow ``z`` given their differences ``d_next`` (inverse of ``difference``)."""
    if DIFFERENCE == 0:
        return np.asarray(d_next, dtype=float).copy()
    ext = list(np.asarray(z, dtype=float))
    for v in d_next:
        ext.append(ext[-DIFFERENCE] + float(v))
    return np.array(ext[len(z):])


def network_inputs(lags: np.ndarray, origins: np.ndarray, start: int) -> np.ndarray:
    """The network's input for windows ``lags`` (one row per origin) ending at ``origins``; ``start``
    is the position in the season of the series' first value (0 for January in a monthly series)."""
    if LAYOUT == "flat":
        if not CALENDAR:
            return lags
        angle = 2 * math.pi * ((start + origins + 1) % SEASON) / SEASON   # the first period forecast
        return np.column_stack([lags, np.sin(angle), np.cos(angle)])
    channels = [lags]
    if CALENDAR:
        steps = origins[:, None] + np.arange(-WINDOW + 1, 1)[None, :]
        angle = 2 * math.pi * ((start + steps) % SEASON) / SEASON
        channels += [np.sin(angle), np.cos(angle)]
    return np.stack(channels, axis=-1 if LAYOUT == "sequence" else 1)


def training_rows(d: np.ndarray, start: int) -> tuple[np.ndarray, np.ndarray]:
    """(inputs, targets) of every origin with a complete window and at least one observed target.
    Targets that are not observed yet are NaN and left out of the loss."""
    n = len(d)
    origins = np.arange(WINDOW - 1, n - 1)
    if not len(origins):
        return np.empty((0,)), np.empty((0, HORIZON))
    lags = d[origins[:, None] + np.arange(-WINDOW + 1, 1)[None, :]]
    ahead = origins[:, None] + np.arange(1, HORIZON + 1)[None, :]
    targets = np.where(ahead < n, d[np.minimum(ahead, n - 1)], np.nan)
    keep = ~np.isnan(lags).any(axis=1) & ~np.isnan(targets).all(axis=1)
    return network_inputs(lags[keep], origins[keep], start), targets[keep]


# --------------------------------------------------------------------------- training
def train_network(inputs: np.ndarray, targets: np.ndarray, seed: int, epochs: int = EPOCHS,
                  batch_size: int = BATCH_SIZE) -> NeuralNetwork:
    """One network, trained deterministically from ``seed`` (the global random state is left untouched)."""
    with torch.random.fork_rng(devices=[]):
        torch.manual_seed(seed)
        network = NeuralNetwork()
        optimizer = make_optimizer(network)
        shuffle = torch.Generator().manual_seed(seed)
        x = torch.as_tensor(inputs, dtype=torch.float32)
        y = torch.as_tensor(np.nan_to_num(targets), dtype=torch.float32)
        observed = torch.as_tensor(~np.isnan(targets), dtype=torch.float32)
        network.train()
        for _ in range(epochs):
            order = torch.randperm(len(x), generator=shuffle)
            for i in range(0, len(x), batch_size):
                batch = order[i:i + batch_size]
                optimizer.zero_grad()
                squared = (network(x[batch]) - y[batch]) ** 2 * observed[batch]
                loss = squared.sum() / observed[batch].sum().clamp(min=1.0)
                loss.backward()
                optimizer.step()
        network.eval()
    return network


class Forecaster:
    """Trained networks, the scaling of the training data and whether they forecast the logarithm."""

    def __init__(self, networks: list, mean: float, scale: float, log: bool):
        self.networks, self.mean, self.scale, self.log = list(networks), float(mean), float(scale), bool(log)

    def next_differences(self, z: np.ndarray, start: int = 0) -> np.ndarray:
        """The HORIZON differences after the end of ``z`` (on the model scale)."""
        d = (difference(z) - self.mean) / self.scale
        t = len(z) - 1
        if t - WINDOW + 1 < 0 or np.isnan(d[t - WINDOW + 1:]).any():
            raise ValueError(f"{MODEL_NAME} needs at least {WINDOW + DIFFERENCE} values to forecast")
        x = torch.as_tensor(network_inputs(d[None, t - WINDOW + 1:], np.array([t]), start), dtype=torch.float32)
        with torch.no_grad():
            out = np.mean([network(x).numpy()[0] for network in self.networks], axis=0)
        return out * self.scale + self.mean

    def predict(self, values, steps: int = HORIZON, start: int = 0) -> np.ndarray:
        """The next ``steps`` values of the series (beyond HORIZON, forecasts feed the next window).
        The series is put on the scale the networks were trained on: a model trained on the
        logarithm refuses a series with a value that is not positive."""
        z = to_model_scale(values, self.log)
        ext = z
        while len(ext) < len(z) + steps:
            ext = np.concatenate([ext, undifference(ext, self.next_differences(ext, start))])
        out = ext[len(z):len(z) + steps]
        return np.exp(out) if self.log else out


def fit(series, starts=None, log=None, seeds=None, epochs: int = EPOCHS, batch_size: int = BATCH_SIZE) -> Forecaster:
    """Train on one series (a sequence of numbers) or on several (a list of sequences: a "global"
    model, which learns the shapes the series share). ``starts`` gives each series' position in
    the season of its first value; ``log``, ``seeds``, ``epochs`` and ``batch_size`` override the
    model's settings (a pooled training set wants fewer, larger batches). The logarithm is used
    only when every value of every series is positive, and the forecaster remembers the decision."""
    log = LOG if log is None else bool(log)
    many = [series] if np.ndim(series[0]) == 0 else list(series)
    starts = [0] * len(many) if starts is None else list(starts)
    logged = can_log(many, log)
    if log and not logged:
        warnings.warn(f"{MODEL_NAME}: a value is not positive, so the series is forecast in levels "
                      "(no logarithm)", stacklevel=2)
    diffs = [difference(to_model_scale(s, logged)) for s in many]
    mean, scale = 0.0, 1.0
    if STANDARDIZE:
        seen = np.concatenate([d[~np.isnan(d)] for d in diffs])
        if len(seen):
            mean, spread = float(seen.mean()), float(seen.std())
            if spread > 0:
                scale = spread
            else:
                warnings.warn(f"{MODEL_NAME}: the differenced training series is constant, so it is "
                              "centred but not rescaled", stacklevel=2)
    rows = [training_rows((d - mean) / scale, s) for d, s in zip(diffs, starts)]
    rows = [r for r in rows if len(r[0])]
    if not rows:
        raise ValueError(f"{MODEL_NAME} needs series of at least {WINDOW + DIFFERENCE + 1} values to train")
    inputs, targets = np.concatenate([r[0] for r in rows]), np.concatenate([r[1] for r in rows])
    seeds = SEEDS if seeds is None else seeds
    networks = [train_network(inputs, targets, seed, epochs, batch_size) for seed in seeds]
    return Forecaster(networks, mean, scale, logged)


def save(forecaster: Forecaster, path: str) -> None:
    """Write the trained networks and their scaling to ``path`` (no timestamp)."""
    torch.save({"model": MODEL_NAME, "mean": forecaster.mean, "scale": forecaster.scale, "log": forecaster.log,
                "states": [n.state_dict() for n in forecaster.networks]}, path)


def load(path: str) -> Forecaster:
    """The forecaster ``save`` wrote to ``path``; refused when it was saved by another model."""
    state = torch.load(path, weights_only=True)
    if state.get("model") != MODEL_NAME:
        raise ValueError(f"{path} holds the {state.get('model')!r} forecaster, not {MODEL_NAME!r}")
    networks = []
    for s in state["states"]:
        network = NeuralNetwork()
        network.load_state_dict(s)
        network.eval()
        networks.append(network)
    return Forecaster(networks, state["mean"], state["scale"], state["log"])


# --------------------------------------------------------------------------- evaluation
def seasonal_naive(values, origin: int, steps: int = HORIZON) -> np.ndarray:
    """The same period a season earlier: the benchmark."""
    last = np.asarray(values, dtype=float)[origin + 1 - SEASON:origin + 1]
    return np.array([last[k % SEASON] for k in range(steps)])


def backtest(values, origins, start: int = 0, log=None, seeds=None) -> dict:
    """Rolling origin: {origin: forecast of the HORIZON values after it}, each trained only on the
    values up to that origin."""
    values = np.asarray(values, dtype=float)
    out = {}
    for o in origins:
        past = values[:o + 1]
        out[int(o)] = fit(past, [start], log=log, seeds=seeds).predict(past, HORIZON, start)
    return out


def mase(values, forecasts: dict) -> dict:
    """{h: MASE} of ``forecasts`` ({origin: array}): the mean absolute error divided by the in-sample
    mean absolute error of the seasonal naive forecast up to each origin (1.0 = as good as it). An
    origin where that in-sample error is zero (or undefined) is left out, with a warning."""
    values = np.asarray(values, dtype=float)
    errors: dict = {}
    for o, f in forecasts.items():
        naive = np.abs(values[SEASON:o + 1] - values[:o + 1 - SEASON])
        scale = float(naive.mean()) if len(naive) else 0.0
        if not scale > 0:
            warnings.warn(f"MASE: the seasonal naive forecast has no in-sample error up to origin {o}, "
                          "so that origin is left out", stacklevel=2)
            continue
        for h in range(1, len(f) + 1):
            if o + h < len(values):
                errors.setdefault(h, []).append(abs(float(f[h - 1]) - values[o + h]) / scale)
    return {h: float(np.mean(e)) for h, e in sorted(errors.items())}


# --------------------------------------------------------------------------- command line
PERIOD = re.compile(r"^\d{4}(-\d{2}|-?Q[1-4])")


def season_start(period: str):
    """The position in the season of a period label, or None when the label does not give it: the
    month of "YYYY-MM" for a monthly series (SEASON 12), the quarter of "YYYY-Qn" for a quarterly
    one (SEASON 4)."""
    month = re.match(r"^\d{4}-(\d{2})", period)
    if SEASON == 12 and month and 1 <= int(month.group(1)) <= 12:
        return int(month.group(1)) - 1
    quarter = re.match(r"^\d{4}-?Q([1-4])", period)
    if SEASON == 4 and quarter:
        return int(quarter.group(1)) - 1
    return None


def read_csv(path: str, column=None) -> tuple[list, np.ndarray]:
    """(periods, values) from a CSV: ``column`` (default: the last column) holds the values; a
    column of "YYYY-MM" or "YYYY-Qn" periods, if any, gives the season position of the series."""
    with open(path, newline="", encoding="utf-8") as f:
        rows = list(csv.DictReader(f))
    if not rows:
        raise ValueError(f"{path} has no rows")
    names = list(rows[0])
    column = column or names[-1]
    periods = []
    for name in names:
        if name != column and all(PERIOD.match(str(r[name])) for r in rows):
            periods = [r[name] for r in rows]
            break
    return periods, np.array([float(r[column]) for r in rows])


def main(argv=None) -> None:
    parser = argparse.ArgumentParser(description=f"Forecast a series with the {MODEL_NAME} network.")
    parser.add_argument("csv", help="a CSV with a column of values (and optionally a period column)")
    parser.add_argument("--column", help="the column of values (default: the last one)")
    parser.add_argument("--steps", type=int, default=HORIZON, help="values to forecast")
    parser.add_argument("--backtest", type=int, default=0, metavar="N", help="score the last N origins")
    parser.add_argument("--save", help="save the trained networks to this file")
    args = parser.parse_args(argv)
    periods, values = read_csv(args.csv, args.column)
    start = season_start(periods[0]) if periods else None
    if start is None:
        if periods:
            print(f"note: the periods do not give the position in a season of {SEASON}; "
                  "the series is taken to start at position 0", file=sys.stderr)
        start = 0
    forecaster = fit(values, [start])
    for k, v in enumerate(forecaster.predict(values, args.steps, start), 1):
        print(f"t+{k}\t{v:.6g}")
    if args.save:
        save(forecaster, args.save)
    if args.backtest:
        n = len(values)
        origins = [o for o in range(n - 1 - args.backtest, n - 1) if o >= WINDOW + DIFFERENCE + SEASON]
        net = mase(values, backtest(values, origins, start))
        naive = mase(values, {o: seasonal_naive(values, o) for o in origins})
        print(f"MASE over {len(origins)} origins (1.0 = seasonal naive in sample)")
        for h in net:
            print(f"h={h}\t{MODEL_NAME} {net[h]:.3f}\tseasonal naive {naive[h]:.3f}")


if __name__ == "__main__":
    main()
