      {
        "id": "ocl_6nabls1jg_mu7ieung_w37",
        "type": "ClassOCLConstraint",
        "position": {
          "x": 0,
          "y": 0
        },
        "width": 160,
        "height": 100,
        "data": {
          "name": "",
          "expression": "context Person inv validEmail: self.email.matches('^[^\\s@]+@[^\\s@]+\\.[A-Za-z]{2,}$')\n\ncontext Person inv validPhone: self.phone.matches('^\\+?[0-9]{7,15}$')"
        }
      },
      {
        "id": "ocl_jyb9dtxcg_mu7ieung_q6e",
        "type": "ClassOCLConstraint",
        "position": {
          "x": 0,
          "y": 0
        },
        "width": 160,
        "height": 100,
        "data": {
          "name": "",
          "expression": "context Booking inv arrivalBeforeDeparture: self.arrivalDate <= self.departureDate\n\ncontext Booking inv guestsWithinCapacity: self.guests->size() <= self.rooms->collect(maxOccupancy)->sum()"
        }
      },
      {
        "id": "ocl_ccum3m92y_mu7ieung_fz6",
        "type": "ClassOCLConstraint",
        "position": {
          "x": 0,
          "y": 0
        },
        "width": 160,
        "height": 100,
        "data": {
          "name": "",
          "expression": "context Room inv noOverlappingBookings: self.bookings->forAll(b1, b2 | b1 <> b2 implies b1.departureDate <= b2.arrivalDate or b2.departureDate <= b1.arrivalDate)"
        }
      }
    ],
