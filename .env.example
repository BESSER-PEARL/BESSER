# BESSER Backend Configuration (.env.example)
# This is the BACKEND-ONLY environment file.
# 
# Frontend configuration is in: besser/utilities/web_modeling_editor/frontend/packages/webapp/webpack/.env.example

# === GMAIL Configuration (Backend Only) ===
FEEDBACK_EMAIL=your-email@example.com,team@example.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# === GitHub OAuth (Backend Only) ===
# Create OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=https://editor.besser-pearl.org/besser_api/github/auth/callback
GITHUB_REDIRECT_URI_LOCAL=http://localhost:9000/besser_api/github/auth/callback

# === OpenAI (Backend Only) ===
# Used by image-to-model, knowledge graph, and agent personalization features
OPENAI_API_KEY=your_openai_key_here

# === Custom LLM endpoints: PIA / Ollama (Backend + modeling agent) ===
# Let requests carry their own base URL, as the PIA and Local (e.g. Ollama)
# providers do. Empty = on in the local docker-compose.yml, off everywhere else;
# export "true" for a run without Docker. Keep off on any shared or hosted
# deployment: the server would open a user-supplied URL (SSRF).
BESSER_LLM_ALLOW_CUSTOM_BASE_URL=
BESSER_AGENT_ALLOW_CUSTOM_BASE_URL=

# === Free tier (Backend Only) ===
# Keyless "Free" option for the Spec-Driven Agent, backed by a self-hosted
# open-weight model behind an OpenAI-compatible endpoint (e.g. Ollama). When
# BASE_URL and MODEL are both set, the backend advertises the free tier in
# GET /besser_api/spec-driven/config and injects these server-side — the URL,
# token, and model NEVER travel to the browser. Leave unset to disable.
# SECURITY: TOKEN is a secret (bearer credential to a shared GPU) — set it in
# the real .env on the server only, never commit a value here.
BESSER_FREE_LLM_BASE_URL=
BESSER_FREE_LLM_TOKEN=
BESSER_FREE_LLM_MODEL=
# Extra keyless models offered alongside MODEL, comma-separated. They are
# served by the endpoint ABOVE — same BASE_URL, same TOKEN — so only list ids
# that BASE_URL actually serves. Do NOT list the fallback's model here: the
# fallback lives on a different host with its own credentials
# (BESSER_FREE_LLM_FALLBACK_BASE_URL / _TOKEN / _MODEL) and is advertised from
# those; an id listed in both is dropped from this list so it cannot be sent to
# the wrong endpoint+token pair.
# Worth setting when the provider meters each free model separately: e.g.
# poolside/laguna-s-2.1-free on Command Code advertises no daily request quota
# ("free while capacity lasts"), where meituan/LongCat-2.0:free is capped at
# 100/day — so it keeps the keyless tier usable once the default is spent.
# MODEL stays the default; an alt is only used when a request names it.
BESSER_FREE_LLM_ALT_MODELS=

# === Agent simulator (live agent testing in the editor) ===
# Full reference: docs/source/utilities/agent_simulator.rst
# Shared secret between the backend and the simulator container. The backend
# sends it as the X-Agent-Simulator-Token header on every request; the
# simulator refuses every request with 503 while it is unset. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SIMULATOR_API_TOKEN=change-me-to-a-long-random-string
# Where the backend reaches the simulator (compose service name + port).
AGENT_SIMULATOR_URL=http://besser-wme-agent-simulator:8001
# Backend-side controls.
AGENT_SIMULATOR_REQUIRE_AUTH=true
AGENT_SIMULATOR_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_SIMULATOR_RATE_LIMIT_MAX_REQUESTS=12
AGENT_SIMULATOR_RATE_LIMIT_MAX_KEYS=10000
AGENT_SIMULATOR_MAX_SESSIONS_PER_ACTOR=1
AGENT_SIMULATOR_RESTRICT_CUSTOM_CODE=true
AGENT_SIMULATOR_QUOTA_ENABLED=false
# Simulator container ceilings (compose) -- also reported to the editor.
AGENT_SIMULATOR_MEMORY_MB=6144
AGENT_SIMULATOR_CPU_CORES=2
AGENT_SIMULATOR_DISK_MB=512
# Session pool and lifetime (the lifetime is read by both services).
AGENT_SIMULATOR_MAX_SESSIONS=5
AGENT_SIMULATOR_SESSION_LIFETIME_SECONDS=900
AGENT_SIMULATOR_PORT_POOL_START=7700
AGENT_SIMULATOR_SESSION_UID_BASE=20000
# Per-session resource limits (setrlimit).
AGENT_SIMULATOR_RLIMIT_AS_GB=4
AGENT_SIMULATOR_RLIMIT_CPU_SEC=120
AGENT_SIMULATOR_RLIMIT_FSIZE_MB=100
AGENT_SIMULATOR_RLIMIT_NPROC=64
AGENT_SIMULATOR_RLIMIT_NOFILE=1024
# auto = every session runs inside bubblewrap and is refused if the sandbox
# cannot start. off = run sessions unconfined: single-tenant development ONLY.
AGENT_SIMULATOR_SANDBOX=auto
