    # initiator: thread the task through the authored governed-merge pipeline,
    # each stage PUSHed to its owner and feeding the next.
    return {"reply": _run_merge_pipeline(task)}
{% endif %}
{% if a2a.peers %}
    parts = await _fanout(reply)
    peer_ctx = "\n\n".join(f"[{name} · {label}]\n{txt}" for name, label, txt in parts)
    return {"reply": f"{reply}\n\nPeer feedback:\n{peer_ctx}" if peer_ctx else reply}
{% else %}
    return {"reply": reply}
