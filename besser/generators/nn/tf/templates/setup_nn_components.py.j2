{# Template for nn components #}

{%- macro strip_counter(name) -%}
    {# Strip counter suffix if global flag is set #}
    {%- if strip_layer_counter_suffix -%}
        {{- name|strip_counter_suffix -}}
    {%- else -%}
        {{- name -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro get_layer_name(module_name, strip_counter_flag=False) -%}
    {# Strip _layer suffix #}
    {%- set name = module_name.rsplit('_', 1)[0] if module_name.endswith('_layer') else module_name -%}
    {# Strip counter suffix (_N) if requested using custom filter #}
    {%- if strip_counter_flag -%}
        {{- name|strip_counter_suffix -}}
    {%- else -%}
        {{- name -}}
    {%- endif -%}
{%- endmacro -%}

{% macro add_to_set(current_set, new_element) %}
    {{ current_set }}
    {% if new_element not in current_set %}
        new_element not in current_set
        {% set updated_set = current_set + [new_element] %}
    {% else %}
        {% set updated_set = current_set %}
    {% endif %}
    {{ updated_set }}
{% endmacro %}

{%- macro initialize_dict(dict_def, key) -%}
    {%- set _ = dict_def.update({key: []}) -%}
{%- endmacro -%}

{%- macro get_hidden_state_var(hx_source, modules_details) -%}
    {# PRIORITY 1: Try to read from layer.hidden_state_var attribute (NEW migration) #}
    {%- if (hx_source + '_layer') in modules_details -%}
        {%- set layer_details = modules_details[hx_source + '_layer'] -%}
        {%- if layer_details|length > 3 and layer_details[3] is defined -%}
            {%- set layer_obj = layer_details[3] -%}
            {%- if layer_obj.hidden_state_var is defined and layer_obj.hidden_state_var -%}
                {{- layer_obj.hidden_state_var -}}
            {%- elif layer_details|length > 4 -%}
                {{- layer_details[4] -}}
            {%- endif -%}
        {%- elif layer_details|length > 4 -%}
            {{- layer_details[4] -}}
        {%- endif -%}
    {# PRIORITY 2: Fall back to checking _op (for tensorop sources) #}
    {%- elif (hx_source + '_op') in modules_details -%}
        {{- modules_details[hx_source + '_op'][1] -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro get_cell_state_var(hx_source, modules_details) -%}
    {# PRIORITY 1: Try to read from layer.cell_state_var attribute (NEW migration) #}
    {%- if (hx_source + '_layer') in modules_details -%}
        {%- set layer_details = modules_details[hx_source + '_layer'] -%}
        {%- if layer_details|length > 3 and layer_details[3] is defined -%}
            {%- set layer_obj = layer_details[3] -%}
            {%- if layer_obj.cell_state_var is defined and layer_obj.cell_state_var -%}
                {{- layer_obj.cell_state_var -}}
            {# PRIORITY 2: Fall back to modules_details index 5 or 4_cell #}
            {%- elif layer_details|length > 5 -%}
                {{- layer_details[5] -}}
            {%- elif layer_details|length > 4 -%}
                {{- layer_details[4] ~ '_cell' -}}
            {%- endif -%}
        {%- elif layer_details|length > 5 -%}
            {{- layer_details[5] -}}
        {%- elif layer_details|length > 4 -%}
            {{- layer_details[4] ~ '_cell' -}}
        {%- endif -%}
    {%- else -%}
        {{- get_hidden_state_var(hx_source, modules_details) ~ '_cell' -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro get_bidirectional_var(layer_name, direction, modules_details) -%}
    {%- set layer_details = modules_details.get(layer_name + '_layer') -%}
    {%- if layer_details and layer_details|length > 3 and layer_details[3] is defined -%}
        {%- set layer_obj = layer_details[3] -%}
        {%- if direction == 'forward' and layer_obj.forward_output_var -%}
            {{- layer_obj.forward_output_var -}}
        {%- elif direction == 'backward' and layer_obj.backward_output_var -%}
            {{- layer_obj.backward_output_var -}}
        {%- else -%}
            {{- layer_name + '_' + direction + '_h' -}}
        {%- endif -%}
    {%- else -%}
        {{- layer_name + '_' + direction + '_h' -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro get_hidden_subscript_assignment(layer_name, modules_details) -%}
    {# Read from layer attributes #}
    {%- if (layer_name + '_layer') in modules_details -%}
        {%- set layer_details = modules_details[layer_name + '_layer'] -%}
        {%- if layer_details|length > 3 and layer_details[3] is defined -%}
            {%- set layer_obj = layer_details[3] -%}
            {%- if layer_obj.hidden_subscript_target is defined and layer_obj.hidden_subscript_target -%}
                {# Use explicit source if defined, otherwise default to the hidden state variable (module_details[4]) #}
                {%- set tuple_var = layer_obj.hidden_subscript_source if (layer_obj.hidden_subscript_source is defined and layer_obj.hidden_subscript_source) else layer_details[4] -%}
                {%- set subscript_var = layer_obj.hidden_subscript_target -%}
                {%- if tuple_var and subscript_var and tuple_var != subscript_var %}
        {{ subscript_var }} = {{ tuple_var }}
                {%- endif -%}
            {%- endif -%}
        {%- endif -%}
    {%- endif -%}
{%- endmacro -%}

{%- macro get_split_output_vars(op_name, modules_details) -%}
    {# Read from tensorop.output_var_joined attribute #}
    {%- if modules_details and (op_name + '_op') in modules_details -%}
        {%- set op_details = modules_details[op_name + '_op'] -%}
        {%- if op_details|length > 2 and op_details[2] is defined -%}
            {%- set tensorop = op_details[2] -%}
            {%- if tensorop.tns_type == 'split' and tensorop.output_var_joined is defined and tensorop.output_var_joined -%}
                {{- tensorop.output_var_joined -}}
            {%- endif -%}
        {%- endif -%}
    {%- endif -%}
{%- endmacro -%}

{%- macro is_split_op(op_name, modules_details) -%}
    {%- if modules_details and (op_name + '_op') in modules_details -%}
        {%- set op_details = modules_details[op_name + '_op'] -%}
        {%- if op_details|length > 2 and op_details[2] is defined -%}
            {%- set tensorop = op_details[2] -%}
            {{- 'true' if tensorop.tns_type == 'split' else '' -}}
        {%- endif -%}
    {%- endif -%}
{%- endmacro -%}

{%- macro get_sequential_vars(module_name, default_var, module_details_dict=None) -%}
    {%- set base_name = module_name.rsplit('_', 2)[0] -%}
    {%- if module_details_dict and "subnn_input" in module_details_dict and "subnn_output" in module_details_dict -%}
        {%- set input_var = module_details_dict["subnn_input"] if module_details_dict["subnn_input"] else default_var -%}
        {%- set output_var = module_details_dict["subnn_output"] if module_details_dict["subnn_output"] else default_var -%}
    {%- else -%}
        {%- set input_var = default_var -%}
        {%- set output_var = default_var -%}
    {%- endif -%}
    {{- output_var + '|||' + input_var -}}
{%- endmacro -%}

