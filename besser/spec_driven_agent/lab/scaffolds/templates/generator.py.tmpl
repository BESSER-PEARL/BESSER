"""${title} generator: one ``${output_file}`` file from a B-UML structural model."""

import logging
import os

from besser.BUML.metamodel.structural import DomainModel
from besser.generators import GeneratorInterface
from besser.utilities.generation_trace import traced_environment

logger = logging.getLogger(__name__)

TEMPLATES_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "templates")
OUTPUT_FILE = "${output_file}"


class ${class_name}(GeneratorInterface):
    """Writes ``${output_file}``: each class of the model with its attributes.

    Args:
        model (DomainModel): The structural model.
        output_dir (str, optional): Where to write; None means ``<current directory>/output``.
    """

    regenerable = True

    def __init__(self, model: DomainModel, output_dir: str = None):
        super().__init__(model, output_dir)

    def generate(self):
        """Render the template into ``OUTPUT_FILE`` in the output directory."""
        env = traced_environment(TEMPLATES_DIR, trim_blocks=True, lstrip_blocks=True)
        rendered = env.get_template("${template_file}").render(model=self.model)
        self._write_traced(OUTPUT_FILE, rendered)
        logger.info("Code generated in the location: %s", self.build_generation_path(OUTPUT_FILE))
