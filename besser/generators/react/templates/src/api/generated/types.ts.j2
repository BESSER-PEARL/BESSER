// The records and request bodies of the backend API, generated from the domain model
// "[[ api_contract.model ]]" with the backend (its api_contract.json and API.md say the same).
// Regenerating rewrites this file: put your own types elsewhere.
//
// A relation is written and read under different keys: a create/update body WRITES the
// association end with ids (`<Class>Create`), a record READ back carries the foreign-key
// column `<end>_id` of the side that holds it (`<Class>`). A name this file derives that is
// already a class or enumeration of the model gets a number (`TaskCreate2`).
{% for name, literals in api_contract.enums.items() %}

export type [[ name ]] = {% for literal in literals %}"[[ literal ]]"[[ " | " if not loop.last else ";" ]]{% endfor %}
{% endfor %}
{% for name, link in api_contract.links.items() %}
{% set names = type_names[name] %}

/** Attributes of one [[ name ]] link, sent when two records are linked. */
export interface [[ names.link_attributes ]] {
{% for field in link.attributes %}
  [[ field.name ]][[ "" if field.required else "?" ]]: [[ field | ts_field(type_names) ]];
{% endfor %}
}

/** One [[ name ]] link in a create body: the linked record's id and the link's attributes. */
export interface [[ names.link ]] extends [[ names.link_attributes ]] {
  target: {% for type in link.target %}[[ type | ts_type ]][[ " | " if not loop.last else ";" ]]{% endfor %}

}
{% endfor %}
{% for entity in api_contract.entities %}
{% set names = type_names[entity.name] %}

/** [[ entity.name ]] as every read returns it. */
export interface [[ names.record ]] {
{% for field in entity.read %}
  [[ field.name ]]: [[ field | ts_field(type_names) ]];
{% endfor %}
}

/** The body that creates or updates [[ entity.name ]] (PUT replaces every field). */
export interface [[ names.create ]] {
{% for field in entity.write %}
  [[ field.name ]][[ "" if field.required else "?" ]]: [[ field | ts_field(type_names) ]];
{% endfor %}
}
{% if entity.detailed %}

/** [[ entity.name ]] with its related records (GET [[ entity.path ]]?detailed=true). */
export interface [[ names.detailed ]] extends [[ names.record ]] {
{% for field in entity.detailed %}
  [[ field.name ]]: [[ field | ts_field(type_names) ]];
{% endfor %}
}
{% endif %}
{% set search = api_routes[entity.name].crud.get("search") %}
{% if search %}

/** Filters of GET [[ search.path ]]: text matches a substring, any other value exactly. */
export interface [[ names.search ]] {
{% for param in search.query %}
  [[ param.name ]]?: [[ param.type | ts_type ]];
{% endfor %}
}
{% endif %}
{% endfor %}
