# Settings of the local BESSER Lab container (docker-compose.lab.yml). Copy this file to .env.lab and fill in the
# four values marked "Required". The folders and addresses of local mode are set in docker-compose.lab.yml.
# .env.lab holds keys: keep it out of git.

# Required. Comma-separated GitHub logins allowed to sign in, e.g. your own.
BESSER_LAB_ALLOWED_LOGINS=
# Logins among the allowed ones who may drop anyone's change and stop any run.
BESSER_LAB_ADMIN_LOGINS=

# Required. API key of BESSER_LAB_LLM_PROVIDER; every run of the lab agent is paid with it.
BESSER_LAB_LLM_API_KEY=
BESSER_LAB_LLM_PROVIDER=anthropic
BESSER_LAB_LLM_MODEL=claude-sonnet-5-5
BESSER_LAB_PLAN_LLM_MODEL=claude-opus-5-5

# A GitHub OAuth app of your own: Homepage URL http://localhost:8080, Authorization callback URL
# http://localhost:9000/besser_api/github/auth/callback. Required, both.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where changes start and their pull requests go (owner/name@branch). To try the lab, point them at forks.
BESSER_LAB_REPO_BESSER=BESSER-PEARL/BESSER@development
BESSER_LAB_REPO_FRONTEND=BESSER-PEARL/BESSER-Web-Modeling-Editor@develop
BESSER_LAB_REPO_MODELING_AGENT=BESSER-PEARL/modeling-agent@develop

# Limits: one run, then per UTC month for one login and for all.
BESSER_LAB_MAX_COST_USD=5.0
BESSER_LAB_USER_MONTHLY_CAP_USD=75.0
BESSER_LAB_MONTHLY_CAP_USD=300.0

# A separate OpenAI key for the preview's assistant, held by the lab's LLM proxy only. Blank: it does not answer.
BESSER_LAB_PREVIEW_OPENAI_API_KEY=

# Behind a proxy (git, npm, uv and the LLM calls all go out through it):
# HTTPS_PROXY=http://proxy.example.org:8080
# HTTP_PROXY=http://proxy.example.org:8080
# NO_PROXY=127.0.0.1,localhost
