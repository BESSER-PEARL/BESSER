    _pending = session.get("gov_pending")
    if GOVERNANCE_REQUIRES_HUMAN and _pending:
        session.delete("gov_pending")
        sys_msg = SYSTEM_PROMPT + "\n\n" + GOVERNANCE_INSTRUCTION
        final = reply_llm.predict(
