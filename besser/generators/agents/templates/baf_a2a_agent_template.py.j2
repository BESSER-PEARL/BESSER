{% if a2a.peers or a2a.states or a2a.merge_sends or a2a.governance %}
# -- A2A client: fan out to every replica of each downstream peer --
def _peer_replica_urls(service, port=8000):
    # Docker DNS can return one address per running replica. Fall back to the
    # service VIP if only one address resolves.
    try:
        ips = sorted({ai[4][0] for ai in socket.getaddrinfo(service, port, proto=socket.IPPROTO_TCP)})
    except OSError:
        ips = []
    return [f"http://{ip}:{port}" for ip in ips] or [f"http://{service}:{port}"]

{% if a2a.has_merge_targets or a2a.states %}
def _a2a_call(base_url, agent_id, message, flow=None, leaf=False):
    # When this edge feeds a governed merging gateway, tag the message with the
    # target gateway id (`flow`) so the owner dispatches it to the right merge
    # state. Omit it for non-merge edges.
    _params = {"message": message}
    if flow:
        _params["flow"] = flow
    if leaf:
        _params["leaf"] = True
    body = json.dumps({"jsonrpc": "2.0", "agent_id": agent_id, "method": "handle",
                       "params": _params, "id": 1}).encode()
{% else %}
def _a2a_call(base_url, agent_id, message, leaf=False):
    _params = {"message": message}
    if leaf:
        _params["leaf"] = True
    body = json.dumps({"jsonrpc": "2.0", "agent_id": agent_id, "method": "handle",
                       "params": _params, "id": 1}).encode()
{% endif %}
    req = urllib.request.Request(f"{base_url}/a2a", data=body,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=120) as r:
        data = json.loads(r.read())
    return (data.get("result") or {}).get("reply", "")

# Per-kind framing: how the requester frames the task for each peer kind, and
# the label its reply folds under. Transport is unchanged (`_a2a_call`); kind
# shapes only the message wording and the reply label. "plain" is pass-through.
_KIND_FRAME = {
    "delegates":    ("Delegated subtask — complete it and return the result:\n{task}", "result"),
    "supervises":   ("Review the following work. Return approval or concrete corrections:\n{task}", "review"),
    "revises":      ("Revise the following so it is correct and complete; return the revised version:\n{task}", "revision"),
    "collaborates": ("Collaborator input — react and contribute:\n{task}", "input"),
    "plain":        ("{task}", "reply"),         # plain channel (no kind=) — pass through
}

async def _fanout(task, only=None, leaf=False):
    # Fire all peer replicas concurrently; exceptions are logged and filtered out. When
    # `only` is a set of service names, restrict the fan-out to those peers (the governed
    # vote uses it to address producers in round 1 and voters in round 2 separately).
    coros, meta = [], []
{% for peer in a2a.peers %}
    if only is None or "{{ peer.service }}" in only:
        _frame, _label = _KIND_FRAME[{{ (peer.kind or "plain") | tojson }}]
        _msg = _frame.format(task=task)
        _urls = _peer_replica_urls("{{ peer.service }}")
        for _i, url in enumerate(_urls):
{% if (a2a.has_merge_targets or a2a.states) and peer.target_gateway %}
            coros.append(asyncio.to_thread(
                _a2a_call, url, "{{ peer.service }}", _msg,
                flow={{ peer.target_gateway | tojson }}, leaf=leaf))
{% else %}
            coros.append(asyncio.to_thread(
                _a2a_call, url, "{{ peer.service }}", _msg, leaf=leaf))
{% endif %}
            # When a service runs more than one replica, suffix the instance
            # index so merge steps and governance votes can tell the copies
            # apart. Single-replica services keep their plain name.
            _sid = "{{ peer.service }}" + (f"#{_i + 1}" if len(_urls) > 1 else "")
            meta.append((_sid, _label))
{% endfor %}
    results = await asyncio.gather(*coros, return_exceptions=True)
    parts = []
    for (svc, lbl), r in zip(meta, results):
        if isinstance(r, Exception):
            logging.warning("_fanout: peer %s raised %s", svc, r)
        else:
            parts.append((svc, lbl, r))
    return parts

def _run_fanout(task, only=None, leaf=False):
    # Synchronous call sites share the async fan-out helper. When already inside
    # an event loop, run the coroutine in a helper thread to avoid nesting
    # `asyncio.run()`.
    try:
        asyncio.get_running_loop()
    except RuntimeError:
        return asyncio.run(_fanout(task, only=only, leaf=leaf))

    _box = {"parts": [], "error": None}

    def _worker():
        try:
            _box["parts"] = asyncio.run(_fanout(task, only=only, leaf=leaf))
        except Exception as _exc:
            _box["error"] = _exc

    _thread = threading.Thread(target=_worker, daemon=True)
    _thread.start()
    _thread.join()
    if _box["error"] is not None:
        raise _box["error"]
    return _box["parts"]

