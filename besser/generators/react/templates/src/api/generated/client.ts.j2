// The typed client of the backend API, generated from the domain model "[[ api_contract.model ]]"
// with the backend (its api_contract.json and API.md list the same routes).
// Regenerating rewrites this file: put your own calls elsewhere.
//
// Every function returns the plain value: a record, an array of records, a count. The
// backend's wrappers (`{"task": ..., "tag_ids": [...]}`, `{"tags_count": ..., "tags": [...]}`,
// `{"params": {...}}`) never reach the caller. Every failure is thrown as one ApiError.
import type * as T from "./types";

/** The backend's address (VITE_API_URL, without a trailing slash): the one place it is defined. */
export const API_BASE_URL: string = String(import.meta.env.VITE_API_URL || "[[ api_contract.base_url.default ]]").replace(/\/+$/, "");

/**
 * A failed request. `status` is the HTTP status (0 when the backend was not reached),
 * `message` what to show the user, `fields` the message per invalid body field (422).
 */
export class ApiError extends Error {
  status: number;
  fields: Record<string, string>;
  body: unknown;

  constructor(status: number, message: string, fields: Record<string, string> = {}, body: unknown = null) {
    super(message);
    Object.setPrototypeOf(this, ApiError.prototype);
    this.name = "ApiError";
    this.status = status;
    this.fields = fields;
    this.body = body;
  }
}

const describe = (value: unknown): string => (typeof value === "string" ? value : JSON.stringify(value));

/** Both error bodies the backend sends: {error, message, detail} and FastAPI's 422 {detail: [...]}. */
const errorFromResponse = (status: number, body: unknown): ApiError => {
  const data = (body && typeof body === "object" ? body : {}) as Record<string, any>;
  const detail = data.detail;
  if (Array.isArray(detail)) {
    const fields: Record<string, string> = {};
    const parts = detail.map((item: any) => {
      const field = Array.isArray(item?.loc) && item.loc.length ? String(item.loc[item.loc.length - 1]) : "field";
      fields[field] = String(item?.msg ?? "invalid");
      return `${field}: ${fields[field]}`;
    });
    return new ApiError(status, parts.join("; "), fields, body);
  }
  if (detail !== undefined && detail !== null && detail !== "") {
    const message = typeof detail === "object" && typeof detail.message === "string" ? detail.message : describe(detail);
    return new ApiError(status, message, {}, body);
  }
  if (typeof data.message === "string" && data.message) return new ApiError(status, data.message, {}, body);
  if (typeof body === "string" && body) return new ApiError(status, body, {}, body);
  return new ApiError(status, `Request failed with status ${status}`, {}, body);
};

/** A path joined to API_BASE_URL (an http(s) URL is kept), with its query parameters. */
export const apiUrl = (path: string, query?: object): string => {
  const base = /^https?:\/\//i.test(path) ? path : API_BASE_URL + (path.startsWith("/") ? path : `/${path}`);
  const params = Object.entries(query || {})
    .filter(([, value]) => value !== undefined && value !== null && value !== "")
    .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(String(value))}`);
  if (!params.length) return base;
  return base + (base.includes("?") ? "&" : "?") + params.join("&");
};

/** One request to the backend: the parsed JSON body, or an ApiError. */
export async function apiRequest<R>(method: string, path: string, options: { query?: object; body?: unknown } = {}): Promise<R> {
  let response: Response;
  try {
    response = await fetch(apiUrl(path, options.query), {
      method,
      headers: options.body === undefined ? undefined : { "Content-Type": "application/json" },
      body: options.body === undefined ? undefined : JSON.stringify(options.body),
    });
  } catch (cause) {
    throw new ApiError(0, "Network error. Please try again.", {}, cause);
  }
  const text = await response.text();
  let data: unknown = null;
  if (text) {
    try {
      data = JSON.parse(text);
    } catch {
      data = text;
    }
  }
  if (!response.ok) throw errorFromResponse(response.status, data);
  return data as R;
}

const seg = (value: string | number): string => encodeURIComponent(String(value));
{% macro params(route) %}{% for p in route.path_params %}[[ p.name ]]: [[ p.type | ts_type ]][[ ", " if not loop.last else "" ]]{% endfor %}{% endmacro %}
{% macro record_call(route, entity, method, extra="") %}{% if route.response.kind == "wrapped_record" %}(await apiRequest<{ [[ route.response.key ]]: T.[[ entity.name ]] }>("[[ method ]]", [[ route.path | ts_path ]][[ extra ]])).[[ route.response.key ]]{% else %}apiRequest<T.[[ entity.name ]]>("[[ method ]]", [[ route.path | ts_path ]][[ extra ]]){% endif %}{% endmacro %}
{% for entity in api_contract.entities %}
{% set routes = api_routes[entity.name] %}
{% set crud = routes.crud %}
{% set get_route, update_route = crud.get("get"), crud.get("update") %}

/** The [[ entity.name ]] routes ([[ entity.path ]]). */
export const [[ entity.name | api_name ]] = {
{% if crud.list %}
  /** GET [[ crud.list.path ]] */
  list: (): Promise<T.[[ entity.name ]][]> => apiRequest<T.[[ entity.name ]][]>("GET", "[[ crud.list.path ]]"),
{% if entity.detailed %}
  /** GET [[ crud.list.path ]]?detailed=true: each record with its related records. */
  listDetailed: (): Promise<T.[[ entity.name ]]Detailed[]> =>
    apiRequest<T.[[ entity.name ]]Detailed[]>("GET", "[[ crud.list.path ]]", { query: { detailed: true } }),
{% endif %}
{% endif %}
{% if crud.count %}
  /** GET [[ crud.count.path ]] */
  count: async (): Promise<number> => (await apiRequest<{ count: number }>("GET", "[[ crud.count.path ]]")).count,
{% endif %}
{% if crud.page %}
  /** GET [[ crud.page.path ]]: `limit` records from `skip` on (defaults 0 and 100). */
  page: (query: { skip?: number; limit?: number } = {}): Promise<T.ApiPage<T.[[ entity.name ]]>> =>
    apiRequest<T.ApiPage<T.[[ entity.name ]]>>("GET", "[[ crud.page.path ]]", { query: { skip: query.skip, limit: query.limit } }),
{% endif %}
{% if crud.search %}
  /** GET [[ crud.search.path ]] */
  search: (filters: T.[[ entity.name ]]Search): Promise<T.[[ entity.name ]][]> =>
    apiRequest<T.[[ entity.name ]][]>("GET", "[[ crud.search.path ]]", { query: filters }),
{% endif %}
{% if get_route %}
  /** GET [[ get_route.path ]] */
  get: async ([[ params(get_route) ]]): Promise<T.[[ entity.name ]]> =>
    [[ record_call(get_route, entity, "GET") ]],
{% endif %}
{% if crud.create %}
  /** POST [[ crud.create.path ]] */
  create: async (body: T.[[ entity.name ]]Create): Promise<T.[[ entity.name ]]> =>
    [[ record_call(crud.create, entity, "POST", ", { body }") ]],
{% endif %}
{% if crud.bulkCreate %}
  /** POST [[ crud.bulkCreate.path ]] */
  bulkCreate: (items: T.[[ entity.name ]]Create[]): Promise<T.ApiBulkCreateResult<[[ entity.id_type | ts_type ]]>> =>
    apiRequest<T.ApiBulkCreateResult<[[ entity.id_type | ts_type ]]>>("POST", "[[ crud.bulkCreate.path ]]", { body: items }),
{% endif %}
{% if update_route %}
  /** PUT [[ update_route.path ]]: replaces every field. */
  update: async ([[ params(update_route) ]], body: T.[[ entity.name ]]Create): Promise<T.[[ entity.name ]]> =>
    [[ record_call(update_route, entity, "PUT", ", { body }") ]],
{% endif %}
{% if crud.delete %}
  /** DELETE [[ crud.delete.path ]]: returns the deleted record. */
  delete: ([[ params(crud.delete) ]]): Promise<T.[[ entity.name ]]> =>
    apiRequest<T.[[ entity.name ]]>("DELETE", [[ crud.delete.path | ts_path ]]),
{% endif %}
{% if crud.bulkDelete %}
  /** DELETE [[ crud.bulkDelete.path ]] */
  bulkDelete: (ids: [[ entity.id_type | ts_type ]][]): Promise<T.ApiBulkDeleteResult<[[ entity.id_type | ts_type ]]>> =>
    apiRequest<T.ApiBulkDeleteResult<[[ entity.id_type | ts_type ]]>>("DELETE", "[[ crud.bulkDelete.path ]]", { body: ids }),
{% endif %}
{% if routes.relations %}
  relations: {
{% for end, relation in routes.relations.items() %}
    [[ end ]]: {
{% if relation.list %}
      /** GET [[ relation.list.path ]]: the related [[ relation.list.target ]] records. */
      list: async ([[ params(relation.list) ]]): Promise<T.[[ relation.list.target ]][]> =>
        (await apiRequest<{ [[ end ]]: T.[[ relation.list.target ]][] }>("GET", [[ relation.list.path | ts_path ]])).[[ end ]],
{% if relation.list.response.links_key %}
      /** GET [[ relation.list.path ]]: the [[ relation.list.link ]] link rows. */
      links: async ([[ params(relation.list) ]]): Promise<T.[[ relation.list.link ]][]> =>
        (await apiRequest<{ [[ relation.list.response.links_key ]]: T.[[ relation.list.link ]][] }>("GET", [[ relation.list.path | ts_path ]])).[[ relation.list.response.links_key ]],
{% endif %}
{% endif %}
{% if relation.add %}
      /** POST [[ relation.add.path ]] */
      add: async ([[ params(relation.add) ]][[ ", attributes?: T." ~ relation.add.link ~ "LinkAttributes" if relation.add.link else "" ]]): Promise<void> => {
        await apiRequest("POST", [[ relation.add.path | ts_path ]][[ ", { body: attributes }" if relation.add.link else "" ]]);
      },
{% endif %}
{% if relation.remove %}
      /** DELETE [[ relation.remove.path ]] */
      remove: async ([[ params(relation.remove) ]]): Promise<void> => {
        await apiRequest("DELETE", [[ relation.remove.path | ts_path ]]);
      },
{% endif %}
    },
{% endfor %}
  },
{% endif %}
{% if routes.methods %}
  methods: {
{% for method in routes.methods %}
{% set result = "string | null" if method.response.result == "str" else "unknown" %}
{% set optional = method.parameters | selectattr("required") | list | length == 0 %}
    /** POST [[ method.path ]][[ "" if method.implemented else " (answers 501 until it is implemented)" ]] */
    [[ method.op ]]: ([[ params(method) ]][[ ", " if method.path_params and method.parameters else "" ]]{% if method.parameters %}args: { {% for p in method.parameters %}[[ p.name ]][[ "" if p.required else "?" ]]: [[ ("T." ~ p.type) if p.enum else (p.type | ts_type) ]][[ "; " if not loop.last else "" ]]{% endfor %} }[[ " = {}" if optional else "" ]]{% endif %}): Promise<T.ApiMethodResult<[[ result ]]>> =>
      apiRequest<T.ApiMethodResult<[[ result ]]>>("POST", [[ method.path | ts_path ]][[ ", { body: { params: args } }" if method.parameters else "" ]]),
{% endfor %}
  },
{% endif %}
};
{% endfor %}

/** The routes every generated backend has. */
export const systemApi = {
  /** GET / */
  root: (): Promise<{ name: string; version: string; status: string }> => apiRequest("GET", "/"),
  /** GET /health */
  health: (): Promise<{ status: string; timestamp: string; database: string }> => apiRequest("GET", "/health"),
  /** GET /statistics: `<class>_count` per class and `total_entities`. */
  statistics: (): Promise<Record<string, number>> => apiRequest("GET", "/statistics"),
};
