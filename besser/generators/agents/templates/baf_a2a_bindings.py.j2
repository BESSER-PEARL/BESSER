# A2A extends the authored graph. No additional Agent or initial state is created.
from baf.core.transition.condition import Condition
from types import SimpleNamespace
from uuid import uuid4

_A2A_OUTBOUND = {{ a2a.get('outbound_edges', []) | python_repr }}
_A2A_INBOUND = {{ a2a.get('inbound_edges', []) | python_repr }}
_A2A_SENDS = {{ a2a.get('merge_sends', []) | python_repr }}
_A2A_TASK_NAMES = [
{% for state in agent.states %}
{% set task_state = namespace(value=is_class(state, 'ReasoningState')) %}
{% for action in (state.body.actions if state.body else []) %}
{% if is_class(action, 'LLMReply') or is_class(action, 'RAGReply') %}
{% set task_state.value = true %}
{% endif %}
{% endfor %}
{% if task_state.value %}
    {{ state.name | tojson }},
{% endif %}
{% endfor %}
]
_A2A_STATES = {
{% for state in agent.states %}
    {{ state.name | tojson }}: {{ state.name }},
{% endfor %}
}
_A2A_PROFILES = {}
_A2A_FALLBACK_STATES = set()
{% if has_personalization %}
{% for mapping in personalization_mapping %}
{% set profile_suffix = (mapping.name if mapping.name is defined else 'variant_' ~ loop.index) | replace(' ', '_') | replace('-', '_') %}
{% set profile_agent = mapping.agent_model if mapping.agent_model is defined else mapping.model %}
{% if profile_agent and profile_agent.states %}
_A2A_PROFILES[{{ mapping.name | tojson }}] = {
{% for state in profile_agent.states %}
    {{ state.name | tojson }}: {{ state.name }}_{{ profile_suffix }},
{% endfor %}
}
{% endif %}
{% endfor %}
