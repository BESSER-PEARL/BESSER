# Environment of the BESSER Lab backend (besser-lab.service).
#
# provision.sh installs this file once as /etc/besser-lab/lab.env, owned by root with mode 0600, with
# lab.example.org replaced by the lab's host name, and never overwrites it afterwards. systemd reads it as root
# before the service starts; the service user and the lab's sandboxed commands cannot read it from disk.
# The service does not start until the four values marked "Required" are filled in. Write values without quotes.

# -- Who uses the lab ---------------------------------------------------------------------------------------
BESSER_LAB_ENABLED=true
# Required. Comma-separated GitHub logins allowed to sign in and use the lab, e.g. jdoe,asmith
# Read when the service starts: after removing a login, run systemctl restart besser-lab.
BESSER_LAB_ALLOWED_LOGINS=
# Logins among the allowed ones who may drop anyone's change and stop any run; empty: nobody (each change can
# still be dropped by its owner). Fill in the maintainers, comma-separated.
BESSER_LAB_ADMIN_LOGINS=

# -- Folders (README, "Files on the host") ------------------------------------------------------------------
# The working trees: base clones in base/, each change's trees in changes/<id>/, shared stores in .cache/.
# Hidden from every sandbox.
BESSER_LAB_WORKSPACE_ROOT=/srv/besser-lab/work
# Every git directory, outside the working trees; read-only in every sandbox.
BESSER_LAB_GIT_ROOT=/srv/besser-lab/git
# Changes, threads, audit log, team notes, preview logs. Hidden from every sandbox.
BESSER_LAB_STATE_DIR=/srv/besser-lab/state/lab

# -- Repositories (owner/name@branch): where changes start and their pull requests go ------------------------
# Point them at forks to try the lab without touching BESSER-PEARL; a new value affects only new changes.
# Run provision.sh update after changing one, so the base clones follow.
BESSER_LAB_REPO_BESSER=BESSER-PEARL/BESSER@development
BESSER_LAB_REPO_FRONTEND=BESSER-PEARL/BESSER-Web-Modeling-Editor@develop
BESSER_LAB_REPO_MODELING_AGENT=BESSER-PEARL/modeling-agent@develop
# Minutes between two fetches of the base branches; 0: only by hand and when a change opens.
BESSER_LAB_BASE_REFRESH_MINUTES=60

# -- The lab agent's model ------------------------------------------------------------------------------------
BESSER_LAB_LLM_PROVIDER=anthropic
# Blank: the provider's default model.
BESSER_LAB_LLM_MODEL=claude-sonnet-5-5
# The plan step's model, same provider. Blank: BESSER_LAB_LLM_MODEL.
BESSER_LAB_PLAN_LLM_MODEL=claude-opus-5-5
# Required. API key of BESSER_LAB_LLM_PROVIDER.
BESSER_LAB_LLM_API_KEY=

# -- Limits ---------------------------------------------------------------------------------------------------
# One run (a plan or build step): cost (USD) and time (seconds).
BESSER_LAB_MAX_COST_USD=5.0
BESSER_LAB_MAX_RUNTIME_SECONDS=2400
# Per UTC month, from the audit log: what one login's runs and all runs together may cost (USD).
BESSER_LAB_USER_MONTHLY_CAP_USD=75.0
BESSER_LAB_MONTHLY_CAP_USD=300.0
# Runs in progress at once across all changes; more are refused, never queued.
BESSER_LAB_MAX_CONCURRENT_RUNS=2
# Each sandboxed shell gets its own network (pasta, NAT to the internet, no host loopback). README, "Security".
BESSER_LLM_SHELL_NETWORK=private

# -- Try it (the preview) -------------------------------------------------------------------------------------
BESSER_LAB_PREVIEW_ENABLED=true
# One origin per preview slot, each with its own nginx block (ports 9100+10i, 8180+10i, 8865+10i for slot i).
# provision.sh install renders nginx and checks the certificate from this list: run install after changing it.
BESSER_LAB_PREVIEW_URLS=https://preview.lab.example.org,https://preview-2.lab.example.org
# Host address the preview ports are published on; nginx proxies to it.
BESSER_LAB_PREVIEW_BIND=127.0.0.1
# The preview's modeling agent reaches OpenAI only through the lab's LLM proxy, which adds this key; the agent
# itself gets a placeholder. Use a separate project key with a monthly budget, never the lab's key.
# Blank: no proxy, and the preview's assistant does not answer.
BESSER_LAB_PREVIEW_OPENAI_API_KEY=
BESSER_LAB_PREVIEW_OPENAI_BASE_URL=https://api.openai.com/v1
BESSER_LAB_PREVIEW_LLM_PROXY_PORT=9300
# Requests the proxy forwards per UTC day across all slots; more answer 429.
BESSER_LAB_PREVIEW_LLM_MAX_REQUESTS_PER_DAY=2000

# -- GitHub sign-in (the OAuth app of README step 3) ---------------------------------------------------------
# Required.
GITHUB_CLIENT_ID=
# Required.
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://lab.example.org/besser_api/github/auth/callback
# The lab's origin: where sign-in returns to, and what the lab editor is built for.
DEPLOYMENT_URL=https://lab.example.org
CORS_ORIGINS=https://lab.example.org
# Signed-in sessions and their encryption key (written beside them as *.key). Hidden from every sandbox.
OAUTH_SESSIONS_PATH=/srv/besser-lab/state/sessions/oauth_states.enc
USER_TOKENS_PATH=/srv/besser-lab/state/sessions/user_tokens.enc

# -- Run store ------------------------------------------------------------------------------------------------
# The event logs of lab runs, replayed by the run card. Its folder is hidden from every sandbox.
BESSER_LLM_RUN_STORE_PATH=/srv/besser-lab/state/spec_driven_runs.sqlite3
# The lab backend refuses new Spec-Driven runs; kept out of the system temp folder, which sandboxes would mask.
BESSER_LLM_RUN_WORKSPACE_ROOT=/srv/besser-lab/runs

# -- Outbound proxy (only on a host that reaches the internet through one) -----------------------------------
# The lab backend calls the LLM provider and GitHub, and git fetches and pushes over HTTPS. Keep NO_PROXY, or
# the lab's calls to the preview services on 127.0.0.1 go to the proxy too.
# HTTPS_PROXY=http://proxy.example.org:8080
# HTTP_PROXY=http://proxy.example.org:8080
# NO_PROXY=127.0.0.1,localhost
