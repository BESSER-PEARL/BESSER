async def handle(**params):
    task = params.get("message", "")
{% if a2a.states %}
    # A PUSH-tagged message (flow == a governed gateway) is dispatched to that
    # merge; an untagged or unknown message falls through below.
    _cfg = _MERGES.get(params.get("flow"))
